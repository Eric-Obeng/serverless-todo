# Used only by `npm run dev` (local Express server). Point at a deployed stack's resources.
AWS_REGION=eu-central-1
TABLE_NAME=serverless-todo-dev-tasks
SCHEDULE_GROUP_NAME=serverless-todo-dev-task-expiry
EXPIRY_FUNCTION_ARN=arn:aws:lambda:eu-central-1:123456789012:function:serverless-todo-dev-expire-task
SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/serverless-todo-dev-SchedulerInvokeRole-XXXX
SCHEDULER_DLQ_ARN=arn:aws:sqs:eu-central-1:123456789012:serverless-todo-dev-expiry-scheduler-dlq
DEFAULT_DEADLINE_MINUTES=5
PORT=3001
