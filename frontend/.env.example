# Copy to .env.local for local dev. In Amplify Hosting these are injected by
# template.yaml (AWS::Amplify::App EnvironmentVariables) from the stack outputs.
VITE_AWS_REGION=eu-central-1
VITE_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-central-1.amazonaws.com/dev
